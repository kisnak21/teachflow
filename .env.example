# PostgreSQL connection string (Neon recommended)
# https://neon.tech
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret"

# Groq API key for AI lesson plan generation
# https://console.groq.com
GROQ_API_KEY="your-groq-api-key"

# Uploadthing token for file attachments
# https://uploadthing.com
UPLOADTHING_TOKEN="your-uploadthing-token"

# Resend API key for password reset emails
# https://resend.com — optional in dev (reset link printed to console)
RESEND_API_KEY="your-resend-api-key"

# Public base URL of the app (used in password reset emails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Groq model override (optional, defaults to openai/gpt-oss-120b)
# GROQ_MODEL="openai/gpt-oss-120b"

# Alibaba Cloud Model Studio (DashScope) — OpenAI-compatible
# Region Singapore workspace-specific (recommended) or https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# https://www.alibabacloud.com/help/en/model-studio/compatibility-of-openai-with-dashscope
DASHSCOPE_API_KEY="your-dashscope-api-key"
DASHSCOPE_BASE_URL="https://ws-s389xbmcqiujzhpt.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_MODEL_QWEN="qwen3.7-max"
DASHSCOPE_MODEL_DEEPSEEK="deepseek-v4-flash-0731"

# Sender address for password reset emails (must be a verified domain in Resend)
# RESEND_FROM_EMAIL="TeachFlow <no-reply@yourdomain.com>"
